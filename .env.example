# Prisma (Postgres, hosted on Supabase) — use the connection pooler URL from your Supabase project settings
DATABASE_URL=
# Optional: direct (non-pooled) connection, required for Prisma Migrate if DATABASE_URL uses the pooler
DIRECT_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend — from https://resend.com/api-keys, used for verification/reset emails
RESEND_API_KEY=
RESEND_FROM_EMAIL="SST Flow <onboarding@resend.dev>"
